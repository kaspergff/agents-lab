else
  export NODE_PATH="/home/kasper/projects/agent-lab/ai-agents/node_modules/.pnpm/mastra@1.15.0_@hono+node-server@1.19.14_hono@4.12.26__@mastra+core@1.45.0_@grpc+grpc-js_a9ce5b291665d00d54c75cca2be69283/node_modules/mastra/node_modules:/home/kasper/projects/agent-lab/ai-agents/node_modules/.pnpm/mastra@1.15.0_@hono+node-server@1.19.14_hono@4.12.26__@mastra+core@1.45.0_@grpc+grpc-js_a9ce5b291665d00d54c75cca2be69283/node_modules:/home/kasper/projects/agent-lab/ai-agents/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../mastra/dist/index.js" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../mastra/dist/index.js" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../mastra/dist/index.js" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../mastra/dist/index.js" "$@"
else
  exec node  "$basedir/../mastra/dist/index.js" "$@"
fi
